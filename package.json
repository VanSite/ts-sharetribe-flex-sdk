{
  "name": "@vansite/ts-sharetribe-flex-sdk",
  "version": "3.0.10",
  "description": "This is a TypeScript SDK for Sharetribe Flex API. It reduces the complexity of the API and provides a more user-friendly interface.",
  "keywords": [
    "sharetribe",
    "flex",
    "sdk",
    "typescript",
    "api",
    "client"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "browser": "./dist/index.umd.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "author": "DKogan90 <david_kogan@hotmail.de>",
  "homepage": "https://github.com/VanSite/ts-sharetribe-flex-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanSite/ts-sharetribe-flex-sdk.git"
  },
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "clean": "rm -rf dist lib types",
    "build": "npm run build:bundles && npm run build:types",
    "build:bundles": "pnpm run clean && webpack --mode production",
    "build:test": "webpack --mode development",
    "build:types": "tsc -p tsconfig.build.json",
    "build:publish": "pnpm run build && pnpm publish",
    "analyze": "ANALYZE=true pnpm run build",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-typescript": "7.28.5",
    "@jest/globals": "29.7.0",
    "@jridgewell/gen-mapping": "0.3.13",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/js-cookie": "3.0.6",
    "@types/node": "20.19.41",
    "@types/transit-js": "0.8.3",
    "@types/uuid": "9.0.8",
    "@types/webpack-env": "1.18.8",
    "add": "2.0.6",
    "axios-mock-adapter": "1.22.0",
    "babel-loader": "9.2.1",
    "jest": "29.7.0",
    "stripe": "22.0.1",
    "terser-webpack-plugin": "5.6.0",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "tslint": "6.1.3",
    "typescript": "5.9.3",
    "webpack": "5.106.2",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "axios": "1.16.1",
    "axios-retry": "4.5.0",
    "js-cookie": "3.0.7",
    "transit-js": "0.8.874",
    "uuid": "9.0.1"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ]
  },
  "tslint": {
    "extends": [
      "tslint:recommended"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testRegex": "(/tests/.*|(\\.|/)(test|spec))\\.ts?$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 10000,
    "preset": "ts-jest"
  }
}
